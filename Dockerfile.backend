# FastAPI 运行镜像：保留 Linux 作业所需 make/bash/uv，前端源码不进入镜像。
FROM ghcr.io/astral-sh/uv:0.12.21 AS uv
FROM python:3.12-slim AS base
COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /app
ENV PYTHONUTF8=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy UV_NO_SYNC=1 PYTHONPATH=/app
RUN apt-get update && apt-get install -y --no-install-recommends make bash curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY app ./app
COPY scripts ./scripts
COPY mcp_servers ./mcp_servers
COPY sql ./sql
COPY tests/data ./tests/data
COPY Makefile ./Makefile
RUN mkdir -p data log
EXPOSE 8000
# 单 worker 保持当前图运行时、SQLite checkpoint 与进程内作业状态的一致性。
CMD ["uv", "run", "--no-sync", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# CPU 后台阶段：网页训练/评测/导出无需运行时装包；MCP 仍复用轻量 base。
FROM base AS cpu
RUN uv sync --locked --no-dev --no-install-project --group ml --extra cpu
ENV ML_UV_ARGS="--extra cpu"

# 未指定 target 时保持普通 API 镜像；生产 Compose 显式选择 cpu 阶段。
FROM base AS runtime
