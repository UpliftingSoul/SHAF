# 云端主系统模板：复制为 .env，再填写模型密钥及随机生成的容器密码。
# 密码建议用 openssl rand -hex 24；十六进制字符可安全用于数据库连接 URL。
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
MYSQL_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX
MINIO_ROOT_USER=shafminio
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-flash
CHAT_API_KEY=REPLACE_WITH_DEEPSEEK_KEY
CHAT_THINKING=disabled
CHAT_REASONING_EFFORT=
CHAT_REASONING_SPLIT=
# 保守采用官方标称 1M 窗口；实际历史还受 CONTEXT_BUDGET_TURNS 限制。
MODEL_CONTEXT_WINDOW=1000000
EMBED_API_KEY=REPLACE_WITH_SILICONFLOW_KEY
RERANK_API_KEY=REPLACE_WITH_SILICONFLOW_KEY
EMBED_BASE_URL=https://api.siliconflow.cn/v1
RERANK_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 应用容器的 DB/Milvus/MCP/分类器地址由生产 Compose 统一提供。
CORS_ORIGINS=[]
# 默认只允许服务器本机/SSH 隧道；公网 IP 测试改 0.0.0.0，并限制云防火墙来源 IP。
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
# Langfuse Cloud：项目设置创建 API Keys；区域地址必须与项目一致。
# EU https://cloud.langfuse.com / US https://us.cloud.langfuse.com / JP https://jp.cloud.langfuse.com
# 不启用时三项均留空。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# CPU 云服务器的训练起点；源码默认 full，部署模板选择可选 LoRA。
HF_ENDPOINT=https://hf-mirror.com
CH10_TRAIN_MODE=lora
CH10_LORA_RANK=64
CH10_LORA_ALPHA=128
CH10_TRAIN_BATCH_SIZE=4
CH10_EVAL_BATCH_SIZE=16
CH10_GRADIENT_ACCUMULATION_STEPS=4
CH10_CPU_THREADS=4
CH10_WARMUP_RATIO=0.1
CH10_LR_SCHEDULER=cosine
CH10_INFERENCE_BATCH_SIZE=32
CH10_INFERENCE_THREADS=4
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
