# 旁路分类器独立镜像：仅安装锁定的 CPU 推理依赖；权重由 data/ 挂载提供。
FROM ghcr.io/astral-sh/uv:0.12.21 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /app
ENV PYTHONUTF8=1 PYTHONUNBUFFERED=1 UV_NO_SYNC=1 UV_LINK_MODE=copy PYTHONPATH=/app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project --group inference
COPY app ./app
COPY scripts/ch10 ./scripts/ch10
RUN mkdir -p data
EXPOSE 8110
CMD ["uv", "run", "--no-sync", "uvicorn", "scripts.ch10.serve:app", "--host", "0.0.0.0", "--port", "8110"]
