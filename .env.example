# ============================================================
# 三组上游各自直连,没有网关。三个 KEY 位是独立的,用同一家上游就填同一个值。
# ============================================================

# --- 聊天 ---
# CHAT_MODEL 必须是上游认的真实模型名(没有网关就没有别名这一层,写错会被上游拒)。
# 下面这组是硅基流动,和嵌入、重排同一家，可共用同一账号。
# 换成 DeepSeek 官方就是:
#   CHAT_BASE_URL=https://api.deepseek.com/v1
#   CHAT_MODEL=deepseek-flash
CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
CHAT_API_KEY=sk-xxx

# --- 思考链 ---
# 必须关。开着的话一句客服回复要 22 秒、token 多花 4 倍(实测 22.4s/318 → 1.4s/16),
# ch01 的流式体验和 ch05 的多步 Agent 都没法看。
# 这个参数名在 OpenAI 协议下是通用的,但能不能关取决于模型:硅基流动的 DeepSeek 和
# MiniMax-M3 能关,MiniMax-M2.x 传了会被静默忽略(官方文档明确说 M2.x 关不掉)。
CHAT_THINKING=disabled
# 开着时的强度,关掉时不用管:low / high / max
# CHAT_REASONING_EFFORT=
# MiniMax 专属,别家不需要。碰到关不掉思考链的模型时开它,让思考进 reasoning_content
# 独立字段,而不是混在 content 里的 <think>——否则结构化输出(意图识别、裁判)会解析失败。
# CHAT_REASONING_SPLIT=true

# --- 嵌入(bge-m3) ---
# BASE_URL 有内置默认值(硅基流动),换上游才需要取消注释
EMBED_API_KEY=sk-xxx
# EMBED_BASE_URL=https://api.siliconflow.cn/v1

# --- 重排(bge-reranker-v2-m3) ---
# 走的是 Jina / Cohere 那套 /rerank 形状,不是 OpenAI 协议
RERANK_API_KEY=sk-xxx
# RERANK_BASE_URL=https://api.siliconflow.cn/v1

TOKEN_BUDGET=2000

# ch02 数据库(复用本机 mewhelp-mysql 容器;全新环境用 docker compose up 起)
# 默认值与下面两行完全一致,不设也能正常工作
# DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/mewhelp
# TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/mewhelp_ch02_test

# ch08 工具系统
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
DEMO_TICKET_DELAY_SECONDS=0

# 前后端分离：同域 Nginx / Vite 代理无需配置跨域；直连时填写明确来源。
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 分类器独立容器部署时改为 http://classifier:8110。
CLASSIFIER_URL=http://127.0.0.1:8110

# ch09 云端可观测：在 Langfuse 项目设置创建密钥，地址必须匹配项目区域。
# EU: https://cloud.langfuse.com；US: https://us.cloud.langfuse.com；JP: https://jp.cloud.langfuse.com。
# 三者齐全才启用；留空时核心业务照常运行。修改后重启后端及相关作业。
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ch10 训练：默认 full 保留全参数路径；改为 lora 启用低秩微调。
# 训练 CLI 优先于环境配置；低资源服务器可减小批量，使用累积步数保持有效批量。
# CH10_TRAIN_MODE=lora
# CH10_LORA_RANK=64
# CH10_LORA_ALPHA=128
# CH10_TRAIN_BATCH_SIZE=4
# CH10_EVAL_BATCH_SIZE=16
# CH10_GRADIENT_ACCUMULATION_STEPS=4
# CH10_CPU_THREADS=4
# CH10_INFERENCE_BATCH_SIZE=32
# CH10_INFERENCE_THREADS=4
